# SerpAPI（必須）— https://serpapi.com/ で無料登録してキーを取得
SERPAPI_KEY=your_serpapi_key_here

# eBay API（出品に必須）— https://developer.ebay.com/ のProductionキーを設定
# App ID (Client ID) をEBAY_CLIENT_IDに、Cert ID (Client Secret) をEBAY_CLIENT_SECRETに設定
EBAY_CLIENT_ID=Yuichiro-merubei-PRD-xxxxxxxxxx
EBAY_CLIENT_SECRET=PRD-xxxxxxxxxxxxxxxxxxxxxxxxxx
# RuName: developer.ebay.com → アプリ名 → User Tokens → 登録後に発行されるRuName
EBAY_RUNAME=Yuichiro-merubei-PRD-xxxxxxxx-xxxxxxxx

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=your_line_notify_token

# Exchange rate API (optional - defaults to fixed rate if not set)
EXCHANGE_RATE_API_KEY=your_api_key
