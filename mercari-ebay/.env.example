# ============================================================
# Mercari認証トークン
# 取得方法: mercari.jpにログイン後、ブラウザのDevTools →
#   Application → Cookies → api.mercari.jp → 値をコピー
#   もしくは Network タブで api.mercari.jp へのリクエストの
#   Authorization: Bearer {token} から取得
# ============================================================
MERCARI_SESSION_TOKEN=your_mercari_bearer_token_here

# ============================================================
# eBay API認証情報
# https://developer.ebay.com/ でアプリ登録後に取得
# ============================================================
EBAY_APP_ID=YourApp-YourApp-PRD-xxxxxxxxxxxx-xxxxxxxx
EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# eBayユーザートークン（出品する売り手アカウントのAuth'n'Authトークン）
# 取得: https://developer.ebay.com/my/auth → User Tokens → Get a Token from eBay via Your Application
EBAY_USER_TOKEN=AgAAAA...your_long_token_here

# eBay出品者のPayPalメールアドレス（eBayアカウントのメール）
EBAY_SELLER_EMAIL=your@email.com

# ============================================================
# 通知設定（いずれかを設定）
# ============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
LINE_NOTIFY_TOKEN=your_line_notify_token

# ============================================================
# 為替レート（任意 - 未設定時は自動取得）
# ============================================================
# USD_JPY_RATE=150.0
